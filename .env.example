# Copy to .env and adjust.

# Host folder to bind-mount into the api/worker containers at /data.
# Folder paths entered in the folder-batch UI must be given as
# container-visible paths under /data/... (e.g. host D:\Videos ->
# DATA_DIR=D:\Videos -> enter /data/... in the UI).
DATA_DIR=./data

# auto | cuda | cpu. Leave as "auto" on the base compose file (CPU-only
# hosts resolve to cpu automatically). docker-compose.gpu.yml overrides
# this to "cuda" for the CUDA host.
DEVICE=auto

# Optional override, e.g. float16, int8, int8_float16. Leave blank to use
# the device-appropriate default (float16 on GPU, int8 on CPU).
COMPUTE_TYPE=
